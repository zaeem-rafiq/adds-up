# Names only. Real values live outside this repository, and on Render as server settings.
# A real run needs the first two. ADDS_UP_TEST=1 runs without them (see README.md).
GEMINI_API_KEY=
# The contact line the SEC requires on every request.
SEC_USER_AGENT=
# Optional. Defaults to gemini-4-carbon.
CAUSE_MODEL=gemini-4-carbon
